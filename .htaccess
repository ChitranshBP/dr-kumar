RewriteEngine On

# ---------------------------------------------------------------------------
# 0. Kill PATH_INFO on index.php.
#
# Before this rule, /index.php/<anything>/<at>/<all> returned HTTP 200 with the
# full homepage, meta robots "index, follow". That is an infinite crawlable URL
# space: any string appended to /index.php/ minted a new indexable URL serving
# duplicate content. It is the vector that got 952+ junk URLs into the index
# (GSC coverage export, 2026-08-12), including nested forms such as
# /index.php/a17576014836566/treatment/tapp-repair-in-chennai.php
#
# AcceptPathInfo Off makes the server reject trailing path info outright; the
# RewriteRule is the belt-and-braces version for configs that ignore it.
# /index.php with no trailing path is untouched and still 301s to / below.
# ---------------------------------------------------------------------------
<IfModule mod_negotiation.c>
    AcceptPathInfo Off
</IfModule>

RewriteCond %{THE_REQUEST} \s/+index\.php/ [NC]
RewriteRule ^ - [G,L]

# ---------------------------------------------------------------------------
# 0b. Legacy spam URLs from the previous WordPress/JetBlog install.
#
# Shape: one letter followed by exactly 14 digits, optionally /m, optionally a
# trailing slash (e.g. /w44868983845169/, /j19496163659514/m). Google Search
# Console reported 952 of these in a single 1,000-row export on 2026-08-12.
#
# Served 410 Gone, NOT 301 to the homepage. A 301 tells Google the URL is
# legitimate and permanently moved, so the URLs stay alive in the index and keep
# consuming crawl budget indefinitely; a mass redirect to an unrelated
# destination also reads as a soft 404. 410 states the resource is gone and is
# honoured faster than 404.
#
# Do NOT add these to robots.txt - a blocked URL cannot be crawled, so Google
# would never see the 410 and would keep the URLs indexed.
#
# Verified against all 172 real URLs and source files: zero false positives.
# Every legitimate slug contains hyphens or letters after the first character.
# These rules sit above the catch-all rewrites below so ordering cannot break
# them.
# ---------------------------------------------------------------------------
RewriteRule ^[a-z]\d{14}(/m)?/?$ - [G,L,NC]

# The JetBlog AJAX spam variant.
RewriteCond %{QUERY_STRING} ^nocache=1777519964&jet_blog_ajax=1$ [NC]
RewriteRule ^about-us/?$ - [G,L]

# Genuine legacy path from the old site - send it to the real About page.
RewriteRule ^about-us/?$ https://herniacare360.com/about-best-hernia-hospital-in-chennai/ [R=301,L,NC]

# ---------------------------------------------------------------------------
# 0c. Canonical host, scheme and trailing slash.
#
# Every URL must resolve to exactly one address:
#     https://herniacare360.com/x     (https, apex, no www, no trailing slash)
#
# Before these rules the identical page answered 200 on all four of:
#     http://herniacare360.com/x
#     https://www.herniacare360.com/x
#     http://www.herniacare360.com/x
#     https://herniacare360.com/x/
#
# The https test checks X-Forwarded-Proto as well as %{HTTPS}. If TLS is ever
# terminated upstream (CDN, proxy), %{HTTPS} alone is not "on" and a scheme
# redirect would loop forever. Testing both makes that impossible.
# ---------------------------------------------------------------------------

# Force https.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{SERVER_PORT} !^443$
RewriteRule ^ https://herniacare360.com%{REQUEST_URI} [R=301,L]

# Force the apex host (drop www).
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://herniacare360.com%{REQUEST_URI} [R=301,L]

# blog/, hernia/ and treatment/ are real folders on disk that double as pages,
# so the -d guard on the general rule below deliberately skips them. Redirect
# them explicitly; block 1 then rewrites the slash-free form to the .php page,
# which is what stops mod_dir adding the slash back and looping.
RewriteRule ^(blog|hernia|treatment)/$ https://herniacare360.com/$1 [R=301,L,NC]

# Strip the trailing slash everywhere else. The -d guard keeps genuine
# directories (/assets/images/ and friends) out of it, because mod_dir would
# re-add the slash and the two rules would bounce off each other forever.
# This must run before blocks 1, 3 and 4, which would otherwise serve the
# trailing-slash URL at 200 instead of redirecting it.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/$ https://herniacare360.com/$1 [R=301,L]

# 1. Page rewrites for directories matching page names
RewriteRule ^blog/?$ blog.php [L,NC]
RewriteRule ^hernia/?$ hernia.php [L,NC]
RewriteRule ^treatment/?$ treatment.php [L,NC]

# 2. Redirect /index or /index.php to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index(\.php)? [NC]
RewriteRule ^index(\.php)?$ / [R=301,L]

# 2b. Redirect any direct request ending in .php to clean non-.php URL
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.php[\s?] [NC]
RewriteCond %{THE_REQUEST} !^[A-Z]{3,}\s/index\.php [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. Clean PHP URLs WITH trailing slash (e.g., /hernia/symptoms/ -> hernia/symptoms.php)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.*)/$ $1.php [L]

# 4. Clean PHP URLs WITHOUT trailing slash (e.g., /hernia/symptoms -> hernia/symptoms.php)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# 301 Redirects for moved pages
RewriteRule ^my_types/inguinal-hernia(\.php)?/?$ https://herniacare360.com/my_types/inguinal-hernia-treatment-in-chennai [R=301,L,NC]
RewriteRule ^my_types/inguinal-hernia-surgery-in-chennai(\.php)?/?$ https://herniacare360.com/my_types/inguinal-hernia-treatment-in-chennai [R=301,L,NC]
RewriteRule ^my_types/umbilical-hernia-surgery-in-chennai(\.php)?/?$ https://herniacare360.com/my_types/umbilical-hernia-treatment-in-chennai [R=301,L,NC]
RewriteRule ^my_types/incisional-hernia-surgery-in-chennai(\.php)?/?$ https://herniacare360.com/my_types/incisional-hernia-treatment-in-chennai [R=301,L,NC]
RewriteRule ^my_types/ventral-hernia-surgery-in-chennai(\.php)?/?$ https://herniacare360.com/my_types/ventral-hernia-treatment-in-chennai [R=301,L,NC]
RewriteRule ^my_types/femoral-hernia-surgery-in-chennai(\.php)?/?$ https://herniacare360.com/my_types/femoral-hernia-treatment-in-chennai [R=301,L,NC]
RewriteRule ^treatment/tapp-repair(\.php)?/?$ https://herniacare360.com/treatment/tapp-repair-in-chennai [R=301,L,NC]
RewriteRule ^treatment/hernia-surgery-in-chennai(\.php)?/?$ https://herniacare360.com/treatment/hernia-surgeon-in-chennai [R=301,L,NC]
RewriteRule ^treatment/hernia-surgeon-in-([a-z-]+)\.php$ https://herniacare360.com/treatment/hernia-surgeon-in-$1 [R=301,L,NC]
RewriteRule ^treatment/([a-z-]+)\.php$ https://herniacare360.com/treatment/$1 [R=301,L,NC]

# (Spam-URL handling lives at the top of this file, above the catch-all
#  rewrites - see block 0b.)

# ---------------------------------------------------------------------------
# Image caching.
#
# Images do get replaced in place on this site, so they must revalidate rather
# than be treated as immutable. Versioned filenames (inguinal-new-v2.png) are
# the real fix; this is the backstop for anything still served under a name
# that gets overwritten.
#
# IfModule-guarded so a host without mod_headers cannot 500 the whole site.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=86400, must-revalidate"
    </FilesMatch>
</IfModule>
